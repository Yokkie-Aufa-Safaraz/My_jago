<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Catatan Keuangan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgJenisCatatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbTabungan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tabungan"
            android:layout_weight="1"/>

        <RadioButton
            android:id="@+id/rbPemasukan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pemasukan"
            android:layout_weight="1"/>

        <RadioButton
            android:id="@+id/rbPengeluaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengeluaran"
            android:layout_weight="1"/>
    </RadioGroup>

    <EditText
        android:id="@+id/etTanggal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Tanggal (1-31)"
        android:inputType="number"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/etBulan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Bulan (1-12)"
        android:inputType="number"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/etTahun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Tahun (Contoh: 2026)"
        android:inputType="number"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/etNominal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nominal (Rp)"
        android:inputType="number"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simpan Catatan"
        android:backgroundTint="#1A73E8"
        android:textColor="@android:color/white"/>
</LinearLayout>
